<layout
  id="MainLayout"
  background="Graphics.COLOR_BLACK"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd"
>
  <label
    x="center"
    y="(dc.getHeight() / 2) - Graphics.getFontHeight(Graphics.FONT_LARGE)"
    text="@Strings.AppName"
    font="Graphics.FONT_LARGE"
    color="Graphics.COLOR_WHITE"
    justification="Graphics.TEXT_JUSTIFY_CENTER"
  />
  <label
    x="center"
    y="(dc.getHeight() / 2) + Graphics.getFontHeight(Graphics.FONT_SMALL)"
    text="@Strings.Ready"
    font="Graphics.FONT_SMALL"
    color="Graphics.COLOR_LT_GRAY"
    justification="Graphics.TEXT_JUSTIFY_CENTER"
  />
</layout>
