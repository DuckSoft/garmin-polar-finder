    function geoidOffset(lat, lon) {
        var la = lat < -90.0 ? -90.0 : (lat > 90.0 ? 90.0 : lat);
        var lo = lon;
        while (lo < -180.0) { lo += 360.0; }
        while (lo >= 180.0) { lo -= 360.0; }
        var fy = (90.0 - la) / 15.0;
        var iy = 0;
        while (iy < 11 && fy >= iy + 1.0) { iy += 1; }
        if (iy >= 11) { fy = 12.0; }
        var wy = fy - iy;
        var fx = (lo + 180.0) / 15.0;
        var ix = 0;
        while (ix < 23 && fx >= ix + 1.0) { ix += 1; }
        var wx = fx - ix;
        var ix1 = ix + 1;
        if (ix1 >= 24) { ix1 = 0; }
        var a = GEOID[iy][ix];
        var b = GEOID[iy][ix1];
        var c = GEOID[iy + 1][ix];
        var d = GEOID[iy + 1][ix1];
        return (a + wx * (b - a)) + wy * ((c + wx * (d - c)) - (a + wx * (b - a)));
    }
    function mslToEllipsoid(lat, lon, msl) { return msl + geoidOffset(lat, lon); }
    function eop(mjd) {
        if (mjd < 61292.0 || mjd > 61659.0) { return {:status => -1, :warning => false}; }
        var i = 0;
        while (i < EOP.size() - 2 && mjd > EOP[i + 1][0]) { i += 1; }
        var a = EOP[i];
        var b = EOP[i + 1];
        var w = (mjd - a[0]) / (b[0] - a[0]);
        return {:status => 0, :dut1 => a[3] + w * (b[3] - a[3]), :xp => (a[1] + w * (b[1] - a[1])) * Astrometry.DAS2R, :yp => (a[2] + w * (b[2] - a[2])) * Astrometry.DAS2R, :first => 61292.0, :last => 61659.0, :warning => (61659.0 - mjd) <= 30.0};
    }
    function firstDate() { return 61292.0; }
    function lastDate() { return 61659.0; }
