/*
 * Bundled Earth data. Geoid samples are from NGA EGM96 (public domain),
 * us_nga_egm96_15.tif (2019-12-27), reduced to a 15-degree global lattice.
 * Bilinear interpolation is continuous and costs little on-device; the coarse
 * lattice trades local relief accuracy (typically several metres) for ROM.
 */
import Toybox.Math;
module GeoidData {
    var GEOID = [
[13.606,13.606,13.606,13.606,13.606,13.606,13.606,13.606,13.606,13.606,13.606,13.606,13.606,13.606,13.606,13.606,13.606,13.606,13.606,13.606,13.606,13.606,13.606,13.606,13.606],
[1.845,0.113,-4.100,-9.129,-11.694,-13.827,-3.988,13.871,18.941,34.965,44.749,46.125,43.723,40.418,20.786,8.164,1.057,-5.983,-7.265,-9.204,-3.628,-1.367,0.899,2.010,1.837],
[0.445,11.887,13.464,6.667,-15.902,-35.865,-47.040,-29.931,4.817,41.214,63.799,59.927,48.227,29.779,15.864,10.344,-3.155,-26.231,-34.119,-31.276,-17.034,5.272,15.998,12.773,0.222],
[-6.432,-2.798,-13.273,-27.436,-19.165,-14.621,-33.788,-32.075,-15.398,27.854,61.268,57.225,47.140,45.141,31.185,1.345,-28.638,-46.929,-59.573,-44.144,-0.157,27.658,16.689,-3.274,-6.537],
[-7.504,-5.973,-15.841,-34.312,-42.404,-24.008,-27.256,-45.821,-40.795,1.281,30.194,39.500,35.389,30.097,16.285,-2.982,-15.439,-46.064,-33.804,-42.572,6.313,35.608,19.817,-3.254,-6.888],
[8.807,9.560,-4.295,-26.103,-44.844,-21.005,2.127,-17.959,-55.380,-25.770,7.846,30.921,22.245,13.946,3.911,-7.147,-52.793,-83.798,-65.065,-22.181,36.043,50.381,44.160,22.765,8.811],
[21.153,15.143,12.727,-6.863,-23.146,-17.555,-4.286,19.591,-12.627,-23.154,2.156,18.763,17.162,-0.409,-8.930,-42.848,-62.160,-99.477,-64.496,13.492,57.194,72.689,63.661,41.154,21.376],
[49.128,13.749,1.247,-10.117,-6.567,-5.069,-5.628,30.370,16.401,-12.755,-7.056,7.265,13.421,23.007,-6.793,-26.045,-26.032,-51.778,-58.711,-29.192,14.191,48.105,63.494,60.027,49.645],
[47.528,13.523,-1.441,-12.063,-10.455,-6.340,0.855,14.665,17.789,-7.315,3.488,14.181,21.409,31.496,31.340,19.135,15.129,0.497,-24.684,-39.426,-22.379,-0.239,30.664,35.801,47.147],
[3.240,-8.553,-11.539,-15.191,-10.932,-8.530,-1.019,13.389,8.724,-3.480,6.801,26.328,21.243,28.465,34.077,45.469,36.068,27.041,7.940,-16.597,-27.354,-20.647,-11.953,-2.865,3.298],
[-46.305,-40.405,-32.403,-29.020,-23.647,-19.893,-11.120,2.254,20.199,16.085,23.544,19.164,15.132,23.505,28.956,34.394,32.624,27.421,9.111,-7.753,-24.391,-32.880,-29.817,-39.761,-46.324],
[-61.530,-63.317,-62.040,-43.561,-36.105,-26.764,-19.206,-11.667,-9.797,-6.561,-1.771,4.426,9.258,14.809,16.573,15.651,13.074,7.828,2.821,-16.582,-35.753,-48.429,-57.658,-57.565,-61.461],
[-29.534,-29.534,-29.534,-29.534,-29.534,-29.534,-29.534,-29.534,-29.534,-29.534,-29.534,-29.534,-29.534,-29.534,-29.534,-29.534,-29.534,-29.534,-29.534,-29.534,-29.534,-29.534,-29.534,-29.534,-29.534]
    ];
    function geoidOffset(lat, lon) {
        var la = lat < -90.0 ? -90.0 : (lat > 90.0 ? 90.0 : lat);
        var lo = lon;
        while (lo < -180.0) { lo += 360.0; }
        while (lo >= 180.0) { lo -= 360.0; }
        var fy = (90.0 - la) / 15.0;
        var iy = 0;
        while (iy < 11 && fy >= iy + 1.0) { iy += 1; }
        if (iy >= 11) { fy = 12.0; }
        var wy = fy - iy;
        var fx = (lo + 180.0) / 15.0;
        var ix = 0;
        while (ix < 23 && fx >= ix + 1.0) { ix += 1; }
        var wx = fx - ix;
        var ix1 = ix + 1;
        if (ix1 >= 24) { ix1 = 0; }
        var a = GEOID[iy][ix];
        var b = GEOID[iy][ix1];
        var c = GEOID[iy + 1][ix];
        var d = GEOID[iy + 1][ix1];
        return (a + wx * (b - a)) + wy * ((c + wx * (d - c)) - (a + wx * (b - a)));
    }
    function mslToEllipsoid(lat, lon, msl) { return msl + geoidOffset(lat, lon); }
}
