    function eop(mjd) {
        mjd = mjd.toDouble();
        if (mjd < 61308.0 || mjd > 61675.0) {
            return { :status => -1, :warning => false };
        }
        var i = Math.floor(mjd - 61308.0).toNumber();
        if (i >= 367) {
            i = 366;
        }
        var w = mjd - (61308.0 + i);
        var a = i * 3;
        var b = a + 3;
        return {
            :status => 0,
            :dut1 => EOP[a + 2] + w * (EOP[b + 2] - EOP[a + 2]),
            :xp => (EOP[a] + w * (EOP[b] - EOP[a])) * Astrometry.DAS2R,
            :yp => (EOP[a + 1] + w * (EOP[b + 1] - EOP[a + 1])) * Astrometry.DAS2R,
            :first => 61308.0,
            :last => 61675.0,
            :warning => (61675.0 - mjd) <= 30.0
        };
    }
    function firstDate() {
        return 61308.0;
    }
    function lastDate() {
        return 61675.0;
    }
}
